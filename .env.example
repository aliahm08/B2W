# Public-facing booking CTA.
VITE_CALENDLY_URL="https://calendly.com/your-team/consultation"

# Server-side project-page passwords. Set these in local env and Vercel project env vars.
PROJECT_ACCESS_SECRET="set-a-long-random-secret"
PROJECT_ACCESS_REGISTRY_PATH="./project-access.registry.json"
PROJECT_PROPOSAL_EMAILS_BOREK_G="info@b2w-ai.com"
PROJECT_PROPOSAL_EMAILS_UYGHUR_EATS=""
PROJECT_PASSWORD_BOREK_G="set-a-unique-password"
PROJECT_PASSWORD_UYGHUR_EATS="set-another-unique-password"

# Private JasonAI executive strategy dashboard.
# Keep the password and signing secret in local/Vercel environment variables only.
JASONAI_EXECUTIVE_PORTAL_PASSWORD="set-a-unique-internal-access-key"
JASONAI_EXECUTIVE_PORTAL_SECRET="set-a-long-random-signing-secret"
# Optional override for the connected GitHub delivery source.
JASONAI_EXECUTIVE_GITHUB_REPO="aliahm08/b2w"

# Private B2W company-wide executive strategy system.
# Defaults to the requested access key when omitted; override it here to rotate access.
B2W_EXECUTIVE_STRATEGY_PASSWORD="B2W-AI-2026"

# JasonAI versioned progress ledger and executive project-manager model.
# These stay server-side; never expose them through VITE_ variables.
# Apply supabase/migrations/202607270001_jasonai_progress_versions.sql before enabling persistence.
JASONAI_PROGRESS_PROJECT_ID="jason-ai"
JASONAI_OSS_MODEL_BASE_URL="https://your-openai-compatible-oss-provider.example.com/v1"
JASONAI_OSS_MODEL_API_KEY="your-server-only-oss-model-api-key"
JASONAI_OSS_MODEL_NAME="your-thinking-model"
JASONAI_OSS_MODEL_API_STYLE="openai"

# Client portal registry and signed session cookie secret.
CLIENT_PORTAL_SECRET="set-a-different-long-random-secret"
CLIENT_PORTAL_REGISTRY_PATH="./client-portal.registry.json"

# Signed proposal transcript delivery and storage.
# Add the signed-proposals folder ID to GOOGLE_DRIVE_ALLOWED_FOLDER_IDS if you want durable Drive-backed storage.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
GOOGLE_DRIVE_ALLOWED_FOLDER_IDS=""
PROPOSAL_SIGNING_SECRET="set-another-long-random-secret"
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="B2W <info@b2w-ai.com>"
INTERNAL_NOTIFICATION_EMAIL="info@b2w-ai.com"
# Optional direct URL to a custom Supabase CRM view. Defaults to the project's table editor.
SUPABASE_CRM_URL="https://supabase.com/dashboard/project/your-project-ref/editor"
PROPOSAL_SIGNING_FROM_EMAIL="B2W <signatures@b2w-ai.com>"
PROPOSAL_SIGNING_INTERNAL_EMAIL="info@b2w-ai.com"
GOOGLE_DRIVE_SIGNED_PROPOSALS_FOLDER_ID=""

# Supabase is the sole system of record for contact, client-message, ROI, and proposal-response submissions.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SECRET_KEY="sb_secret_xxx"
# SUPABASE_SERVICE_ROLE_KEY is the deprecated JWT-based key; prefer SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
