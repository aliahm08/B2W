{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/portal/admin/proposals/[id]/edit",
      "regex": "^/portal/admin/proposals/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/portal/admin/proposals/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/portal/deliverables/[id]",
      "regex": "^/portal/deliverables/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/portal/deliverables/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/portal/proposals/[id]",
      "regex": "^/portal/proposals/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/portal/proposals/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/sign-in/[[...sign-in]]",
      "regex": "^/sign\\-in(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPsignin": "nxtPsign-in"
      },
      "namedRegex": "^/sign\\-in(?:/(?<nxtPsignin>.+?))?(?:/)?$"
    },
    {
      "page": "/sign-up/[[...sign-up]]",
      "regex": "^/sign\\-up(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPsignup": "nxtPsign-up"
      },
      "namedRegex": "^/sign\\-up(?:/(?<nxtPsignup>.+?))?(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/portal",
      "regex": "^/portal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portal(?:/)?$"
    },
    {
      "page": "/portal/admin",
      "regex": "^/portal/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portal/admin(?:/)?$"
    },
    {
      "page": "/portal/admin/audit",
      "regex": "^/portal/admin/audit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portal/admin/audit(?:/)?$"
    },
    {
      "page": "/portal/admin/clients",
